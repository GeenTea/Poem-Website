# Базовый URL NestJS для браузера и SSR.
# Прямой доступ к бэкенду (нужен CORS на стороне Nest):
NEXT_PUBLIC_API_URL=http://localhost:3001

# Либо через встроенный прокси — тогда раскомментируйте строку ниже вместо верхней
# и укажите адрес бэкенда в API_INTERNAL_URL (см. app/api/[...path]/route.ts):
# NEXT_PUBLIC_API_URL=/api

# Адрес NestJS для серверной стороны (route handlers, прокси).
# Не публичный: в браузер не попадает.
API_INTERNAL_URL=http://localhost:3001
