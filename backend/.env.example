# Подключение к PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/poems?schema=public"

# Секрет для подписи JWT. На проде — длинная случайная строка, не такая, как локально.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Порт бэкенда (хостинг обычно задаёт сам)
PORT=3001

# Адрес фронтенда для CORS. На проде — адрес сайта на Vercel.
FRONTEND_URL=http://localhost:3000

# Почта (восстановление пароля, смена почты). Пусто — письма печатаются в консоль бэкенда.
# Пример для Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<пароль приложения из настроек Google-аккаунта>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Poem Nest <no-reply@poemnest.local>"
